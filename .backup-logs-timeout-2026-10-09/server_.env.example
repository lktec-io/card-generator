# ---------------------------------------------------------------------------
# Cardhub Invitation — server environment
#
# PLACEHOLDERS ONLY. Copy to server/.env and fill in the real values there.
# server/.env is gitignored; this file must never contain a real credential.
# ---------------------------------------------------------------------------

# ── Database ────────────────────────────────────────────────────────────────
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# ── Auth ────────────────────────────────────────────────────────────────────
JWT_SECRET=
PORT=8003

# Public origin of the site. Used for invitation links and, importantly, to turn
# a stored card path (/uploads/cards/...) into the absolute HTTPS URL WhatsApp
# needs in order to fetch template media. Must be https:// in production.
PUBLIC_SITE_URL=https://card.clixworks.co.tz

# ── Beem SMS (already live — do not change these for WhatsApp) ──────────────
BEEM_API_KEY=
BEEM_SECRET_KEY=
BEEM_SOURCE_ADDR=INFO

# ── Beem WhatsApp ───────────────────────────────────────────────────────────
# WhatsApp is a separate Beem product from SMS, with its own credentials and an
# APPROVED TEMPLATE. Until API key, secret, sender and template id are all set,
# the API reports WhatsApp as "not configured" and refuses to send rather than
# firing malformed requests. Nothing else needs changing to switch it on.

# Broadcast template-send endpoint. The default below is the one verified
# working on this account; leave unset to use it.
BEEM_WHATSAPP_API_URL=https://apibroadcast.beem.africa/v1/broadcast/template/api-send

BEEM_WHATSAPP_API_KEY=
BEEM_WHATSAPP_API_SECRET=

# The approved Beem sender number. Goes out as `from_addr` — if this is empty
# Beem replies "from_addr Cannot be null/undefined" and nothing is delivered.
# Verified sender for this account: 255706422927
# (BEEM_WHATSAPP_FROM_ADDR and BEEM_WHATSAPP_SENDER_ID are accepted as aliases.)
BEEM_WHATSAPP_FROM=255706422927

# The approved template. 1850 declares six body variables, in this order:
#   {{0}} guest name  {{1}} event name  {{2}} event date
#   {{3}} event time  {{4}} venue       {{5}} invitation URL
# Changing the order means re-approving the template with Beem AND editing
# TEMPLATE_PARAM_ORDER in services/whatsapp/WhatsAppService.js.
BEEM_WHATSAPP_TEMPLATE_ID=1850
BEEM_WHATSAPP_TEMPLATE_LANGUAGE=en

# Where Beem posts delivery reports. Must be public HTTPS.
#
# IMPORTANT: Beem does not send a secret header of its own. If you set
# BEEM_WHATSAPP_CALLBACK_SECRET below, the secret must travel in this URL or
# every callback is rejected (that is the "[whatsapp:webhook] rejected a
# callback with a bad secret" log line):
#   https://card.clixworks.co.tz/api/webhooks/beem/whatsapp?secret=<the secret>
BEEM_WHATSAPP_CALLBACK_URL=

# Optional shared secret. Accepted as ?secret=, X-Beem-Signature,
# X-Webhook-Secret, or Authorization: Bearer. Leave EMPTY to accept
# unauthenticated callbacks (Beem's own IPs are not restricted either way).
BEEM_WHATSAPP_CALLBACK_SECRET=

# Optional tuning.
# basic (default, same scheme as the SMS integration) or bearer
BEEM_WHATSAPP_AUTH_MODE=basic
# Messages per second during a campaign — keep inside the account's rate limit.
BEEM_WHATSAPP_RATE_PER_SECOND=5
BEEM_WHATSAPP_TIMEOUT_MS=20000

# ── Cloudinary (voice messages + contribution templates only; NOT cards) ────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Card storage on this server ─────────────────────────────────────────────
# Defaults to <project>/storage/cards and <project>/storage/templates.
CARD_STORAGE_DIR=
TEMPLATE_STORAGE_DIR=

# ── Bulk card generation tuning ─────────────────────────────────────────────
BULK_CARD_CONCURRENCY=1
BULK_CARD_PAUSE_MS=20
